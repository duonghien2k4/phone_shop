PORT=3001
NODE_ENV=production

DATABASE_URL="postgresql://postgres:your_password@localhost:5432/phone_shop?schema=public"

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Clerk keys must belong to the same Clerk instance as the frontend publishable key.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Optional PEM public key from Clerk Dashboard -> API Keys -> Show JWT public key.
# Use this when verifying Clerk session tokens with a pinned public key.
CLERK_JWT_KEY=

PUBLISHABLE_STRIPE_KEY=pk_test_your_stripe_publishable_key
SECRET_STRIPE_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

EMAILJS_SERVICE_ID=service_xxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxx
EMAILJS_CONFIRM_TEMPLATE_ID=template_xxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://www.your-frontend.vercel.app
